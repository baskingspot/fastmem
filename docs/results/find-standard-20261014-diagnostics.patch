@@ -0,0 +1,83 @@
+const std = @import("std");
+const kernel16 = @import("kernel.zig");
+const kernel32 = @import("kernel32.zig");
+const Family = enum { rare_absent, rare_end, rare_equal, prefix_start, near_absent, uniform_byte_end };
+var hay_buffer: [1048576 + 64]u8 align(64) = undefined;
+var needle_buffer: [4096 + 64]u8 align(64) = undefined;
+
+pub fn diagnostic(
+    writer: *std.Io.Writer,
+    comptime kernel: type,
+    family: Family,
+    hlen: usize,
+    nlen: usize,
+    offset: usize,
+) !void {
+    std.debug.assert(hlen <= 1048576);
+    std.debug.assert(nlen <= 4096);
+    std.debug.assert(offset <= 63);
+    const h = hay_buffer[offset..][0..hlen];
+    const n = needle_buffer[63 - offset ..][0..nlen];
+    switch (family) {
+        .rare_absent, .rare_end, .rare_equal => {
+            for (h, 0..) |*byte, i| byte.* = @intCast(i % 255);
+            for (n, 0..) |*byte, i| byte.* = @intCast(i % 255);
+            n[300] = 255;
+        },
+        .near_absent => {
+            for (n, 0..) |*byte, i| byte.* = @as(u8, @intCast(i % 13)) + 'a';
+            for (h, 0..) |*byte, i| {
+                byte.* = n[i % nlen];
+                if (i % nlen == nlen / 2) byte.* ^= 128;
+            }
+        },
+        .prefix_start, .uniform_byte_end => {
+            @memset(h, 'a');
+            @memset(n, 'a');
+            n[nlen - 1] = 'z';
+        },
+    }
+    const expected: ?usize = switch (family) {
+        .rare_absent, .near_absent => null,
+        .prefix_start, .rare_equal => 0,
+        .rare_end, .uniform_byte_end => hlen - nlen,
+    };
+    if (expected) |pos| @memcpy(h[pos..][0..nlen], n);
+    std.debug.assert(std.mem.find(u8, h, n) == expected);
+    kernel.metrics = .{};
+    const actual = kernel.find(h, n);
+    std.debug.assert(actual == expected);
+    try std.json.Stringify.value(.{
+        .family = @tagName(family),
+        .width = kernel.diagnostic_width,
+        .hlen = hlen,
+        .nlen = nlen,
+        .hay_offset = offset,
+        .needle_offset = 63 - offset,
+        .answer = actual,
+        .metrics = kernel.metrics,
+    }, .{}, writer);
+    try writer.writeByte('\n');
+}
+
+pub fn main(init: std.process.Init) !void {
+    var buffer: [32768]u8 = undefined;
+    var file_writer: std.Io.File.Writer = .init(.stdout(), init.io, &buffer);
+    const writer = &file_writer.interface;
+    inline for (.{ kernel16, kernel32 }) |kernel| {
+        for ([_]usize{ 512, 1024, 4096 }) |nlen| {
+            for ([_]usize{ 65536, 131072, 262144, 1048576 }) |hlen|
+                try diagnostic(writer, kernel, .rare_absent, hlen, nlen, 0);
+            for ([_]usize{ 1, 2, 16 }) |delta|
+                try diagnostic(writer, kernel, .rare_end, nlen + delta, nlen, 0);
+            try diagnostic(writer, kernel, .prefix_start, 32768, nlen, 0);
+        }
+        for ([_]usize{ 33, 257, 1024, 4096 }) |nlen|
+            for ([_]usize{ 65536, 131072, 262144, 1048576 }) |hlen|
+                try diagnostic(writer, kernel, .near_absent, hlen, nlen, 0);
+        for ([_]usize{ 15, 16, 17, 31, 32, 33, 63, 64, 65, 4095, 4096 }) |hlen|
+            for ([_]usize{ 0, 1, 15, 16, 17, 31, 32, 63 }) |offset|
+                try diagnostic(writer, kernel, .uniform_byte_end, hlen, 1, offset);
+    }
+    try writer.flush();
+}

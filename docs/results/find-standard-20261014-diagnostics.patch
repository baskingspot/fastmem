+++ b/.bench-cache/find-regression-diagnostics/probe_equal.zig
@@ -0,0 +1,14 @@
+const std = @import("std");
+const probe = @import("probe.zig");
+const kernel16 = @import("kernel.zig");
+const kernel32 = @import("kernel32.zig");
+
+pub fn main(init: std.process.Init) !void {
+    var buffer: [8192]u8 = undefined;
+    var file_writer: std.Io.File.Writer = .init(.stdout(), init.io, &buffer);
+    const writer = &file_writer.interface;
+    inline for (.{ kernel16, kernel32 }) |kernel|
+        for ([_]usize{ 512, 1024, 4096 }) |nlen|
+            try probe.diagnostic(writer, kernel, .rare_equal, nlen, nlen, 0);
+    try writer.flush();
+}

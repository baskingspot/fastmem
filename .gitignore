.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
*.pem
*.o
crash.log
bench-results/
zig-pkg/
.zig-cache/
zig-out/
.bench-cache/
infra/modules/*/.terraform.lock.hcl

# Core dumps (qemu-user writes qemu_<prog>_<time>_<pid>.core) carry the full
# process environment, secrets included. Never commit them.
*.core
core
core.[0-9]*

# The docs module copies the shared theme here at build time.
docs/themes/
